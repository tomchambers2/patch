{
  "name": "@patch/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Patch mobile (Android-only Expo app).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "build:preview": "eas build --platform android --profile preview --non-interactive --no-wait",
    "build:production": "eas build --platform android --profile production --non-interactive --no-wait",
    "build": "expo export --platform android --output-dir dist --dump-sourcemap",
    "typecheck": "node scripts/gen-router-types.mjs && tsc --noEmit",
    "lint": "eslint app src plugins __tests__ --max-warnings 0",
    "test": "vitest run",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.6.1",
    "@patch/relay": "workspace:*",
    "@patch/wire": "workspace:*",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-camera": "~16.0.0",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.0",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.27.5",
    "lucide-react-native": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-callkeep": "^4.3.16",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "~2.12.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "~18.3.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9",
    "ws": "^8.20.0"
  }
}
