{
  "name": "@patch/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Patch CLI — terminal surface (TUI + agent-facing primitives).",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "patch": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx src/index.ts",
    "lint": "eslint src test",
    "// test": "Discovery is by PATTERN, not a file list (spec/19-testing.md § Unit), so a new test file cannot be silently left out of the suite.",
    "test": "node --test --import tsx \"src/**/*.test.ts\" \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "build:bin": "node ./scripts/build-bin.mjs"
  },
  "dependencies": {
    "@patch/auth": "workspace:*",
    "@patch/wire": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/ws": "^8.5.13",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
