#!/bin/sh
# The artifact's installer entry point.
#
# It exists in shell, ahead of the bundled installer program, for one reason:
# an artifact built for another machine must refuse rather than half-install,
# and on the wrong machine the artifact's own `node` cannot even be executed
# ("cannot execute binary file"). So the platform check happens here, in the
# only language every target already has, before anything is run or written.
#
# Everything after the check is the bundled installer (install.mjs), run under
# the artifact's own pinned Node.
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ ! -f "$DIR/build-info.json" ]; then
  echo "patch install: $DIR/build-info.json is missing — this is not a complete patch host artifact" >&2
  exit 65
fi

ARTIFACT_TARGET=$(sed -n 's/.*"target"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DIR/build-info.json" | head -n 1)
if [ -z "$ARTIFACT_TARGET" ]; then
  echo "patch install: $DIR/build-info.json carries no target — the artifact is not stamped" >&2
  exit 65
fi

case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux) OS=linux ;;
  *) echo "patch install: patch installs on macOS and Linux, not $(uname -s)" >&2; exit 65 ;;
esac
case "$(uname -m)" in
  arm64 | aarch64) ARCH=arm64 ;;
  x86_64 | amd64) ARCH=x64 ;;
  *) echo "patch install: unsupported machine architecture $(uname -m)" >&2; exit 65 ;;
esac
HOST_TARGET="$OS-$ARCH"

if [ "$ARTIFACT_TARGET" != "$HOST_TARGET" ]; then
  echo "patch install: this artifact is for $ARTIFACT_TARGET, but this machine is $HOST_TARGET." >&2
  echo "Nothing has been installed. Download the artifact for this platform and run that one." >&2
  exit 65
fi

if [ ! -x "$DIR/node" ]; then
  echo "patch install: $DIR/node is missing or not executable — the artifact is incomplete" >&2
  exit 65
fi

exec "$DIR/node" "$DIR/install.mjs" "$@"
