{
  "name": "@patch/wire",
  "version": "0.0.0",
  "private": true,
  "description": "Shared wire-protocol types, schemas, and codec for Patch.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test-client": {
      "types": "./dist/test-client.d.ts",
      "import": "./dist/test-client.js",
      "default": "./dist/test-client.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "import": "./dist/jobs.js",
      "default": "./dist/jobs.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js",
      "default": "./dist/audio.js"
    },
    "./device-control": {
      "types": "./dist/device-control.d.ts",
      "import": "./dist/device-control.js",
      "default": "./dist/device-control.js"
    },
    "./web-bot-auth": {
      "types": "./dist/web-bot-auth.d.ts",
      "import": "./dist/web-bot-auth.js",
      "default": "./dist/web-bot-auth.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9",
    "ws": "^8.18.0"
  }
}
