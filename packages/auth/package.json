{
  "name": "@patch/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Auth primitives for Patch: Ed25519 user identity, EdDSA-JWT surface credentials, QR pairing, Claude OAuth loader, revocation registry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.6.1",
    "@patch/wire": "workspace:*",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
