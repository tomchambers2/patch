{
  "name": "@patch/server",
  "version": "0.0.0",
  "private": true,
  "description": "Patch server — Fastify relay, registry, presence, WebSocket hub.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && node scripts/copy-pad-assets.mjs",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "fixtures:mint-surface-jwt": "tsx src/scripts/mint-surface-jwt.ts",
    "fixtures:mint-daemon-key": "tsx src/scripts/mint-daemon-key.ts",
    "migrate:account-key": "tsx src/scripts/migrate-account-key.ts"
  },
  "dependencies": {
    "@doist/todoist-api-typescript": "^7.10.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@patch/auth": "workspace:*",
    "@patch/relay": "workspace:*",
    "@patch/wire": "workspace:*",
    "chokidar": "^5.0.0",
    "fastify": "^5.1.0",
    "jsonata": "^2.1.0",
    "mustache": "^4.2.0",
    "node-cron": "^4.2.1",
    "pino": "^9.5.0",
    "playwright": "^1.61.1",
    "qrcode-terminal": "^0.12.0",
    "rrule": "^2.8.1",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "docx": "^9.8.1",
    "mammoth": "^1.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
