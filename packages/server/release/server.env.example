# Patch server config. The installer copies this to <home>/server.env on a first
# install (mode 600). NOTHING here is required: a server with this file empty
# starts, keeps its state in <home>/data and makes its own secrets there
# (spec/01 § Starting with no settings).

# Where devices reach this server — the address a pairing code and the
# host-install command carry. Set by the installer when it is given one.
# PATCH_PUBLIC_URL=

# Where the server listens. Put a TLS reverse proxy (Caddy, nginx) in front of
# it; only /device/* goes to the daemon (:3003) — /audio/* stays on the server, which relays it to the chat's host.
PORT=3000
HOST=127.0.0.1

# Optional — leave unset to turn them off.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# TODOIST_WEBHOOK_SECRET=
