{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutate": ["src/ws-hub.ts", "src/daemon-link.ts", "src/chat-registry.ts", "src/registry.ts", "src/jobs/dispatcher.ts", "src/jobs/validate.ts"],
  "reporters": ["clear-text", "progress"],
  "concurrency": 6,
  "timeoutMS": 20000,
  "clearTextReporter": { "maxTestsToLog": 0, "reportTests": false, "reportMutants": false }
}
