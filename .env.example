# patch — environment variables
# Copy to `deploy/.env` for the production compose stack, or to `.env` at the
# repo root for local dev. NO FALLBACKS: every required var must be set, or
# the relevant process crashes loudly at boot.

# ─── Public URL & ports ────────────────────────────────────────────────────
# The full https URL the surfaces use to reach the server. In production
# this is the Caddy frontend; in compose-local the test stack uses
# http://localhost:3000 (no TLS).
PATCH_SERVER_URL=https://patch.example.com

# Server bind. Compose maps these into the container; the host-side bind is
# Caddy's :443.
PORT=3000
HOST=0.0.0.0

# Where the server reaches the daemon's TCP healthz (used by
# /api/daemon/healthz proxy). Inside compose this resolves the daemon
# service name.
DAEMON_HEALTHZ_URL=http://daemon:3001/healthz

# Daemon UDS path on the host. The CLI talks to the daemon over this.
PATCH_DAEMON_SOCKET=/root/.patch/daemon.sock
PATCH_DAEMON_HEALTHZ_PORT=3001
PATCH_DAEMON_HEALTHZ_HOST=0.0.0.0

# Build identity baked into /healthz responses. In production the Docker
# build sets these — leave them blank locally and version.ts will read
# package.json + `git rev-parse --short HEAD`.
PATCH_VERSION=
PATCH_GIT_SHA=

# ─── Auth (group 3) ────────────────────────────────────────────────────────
# 32+ random bytes, base64url. Used to sign EdDSA-JWT surface credentials.
PATCH_JWT_SECRET=

# ─── Timezone ──────────────────────────────────────────────────────────────
# Cron expressions are stored & evaluated in UTC; this TZ is applied only
# at parse/display so a user typing "9am" maps to the right UTC schedule.
TZ=Europe/London

# ─── Provider tokens (groups 5, 7, 11) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_USER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TODOIST_TOKEN=
TODOIST_WEBHOOK_SECRET=

# ─── Voice (group 13) ──────────────────────────────────────────────────────
# Whisper STT backend. `groq` (default) hits Groq's REST API; `local` spawns
# faster-whisper as a Python sidecar.
WHISPER_BACKEND=groq
GROQ_API_KEY=
WHISPER_MODEL_PATH=/models/whisper/medium.en

# Kokoro TTS model directory (mounted into the daemon container).
KOKORO_MODEL_PATH=/models/kokoro

# ─── Web SPA build-time (Vite) ─────────────────────────────────────────────
# Set when running `vite build` against a non-default backend (e.g. local
# dev hitting a deployed Hetzner server).
VITE_PATCH_SERVER_URL=

# ─── Mobile (EAS) ──────────────────────────────────────────────────────────
# Read at EAS build time and baked into the JS bundle. Set via
# `eas env:create` per environment, not in this file.
EXPO_PUBLIC_PATCH_SERVER_URL=

# ─── Desktop (Electron) ────────────────────────────────────────────────────
# Used by the Electron shell to load the SPA. Defaults to the public URL
# above; override for local-stack dev.
# PATCH_SERVER_URL is shared with the server.

# Apple Developer ID for codesigning + notarisation. Only needed when
# running `pnpm --filter @patch/desktop dist` on a Mac.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
